---
import Base from '../layouts/Base.astro';
---
<Base title="页面不存在">
  <div class="container page-head">
    <span class="eyebrow">404 / NOT FOUND</span>
    <h1>这个页面尚未找到</h1>
    <p>也许文章已移动或仍在整理。你可以从领域目录、文章索引或者搜索继续。</p>
    <div class="button-row"><a href="/atlas/" class="btn">知识领域</a><a class="btn btn-outline" href="/search/">搜索</a></div>
  </div>
</Base>
